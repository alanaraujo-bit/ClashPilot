    "@clashpilot/core": "workspace:*",
    "@clashpilot/db": "workspace:*",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "fastify": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clashpilot/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
