{
  "name": "@clashpilot/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "sanity": "tsx scripts/sanity-progress.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
