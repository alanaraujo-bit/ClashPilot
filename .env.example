# ─────────────────────────── Banco (Railway) ───────────────────────────
# URL pública com pooler — usada pela Vercel
DATABASE_URL="postgresql://user:pass@host.proxy.rlwy.net:5432/railway"
# URL direta — usada por migrations e pelo worker (rede privada do Railway)
DIRECT_URL="postgresql://user:pass@host.proxy.rlwy.net:5432/railway"

# ─────────────────────── API do Clash of Clans ─────────────────────────
# SÓ o gateway conhece este token. Nunca colocar na Vercel.
# Gerar em https://developer.clashofclans.com com o IP fixo do Railway na allowlist.
COC_API_TOKEN=""

# ───────────────────────── Gateway (web → gateway) ─────────────────────
COC_GATEWAY_URL="http://localhost:4000"
# Segredo HMAC compartilhado entre apps/web e apps/gateway
COC_GATEWAY_SECRET="troque-por-32-bytes-aleatorios"

# ───────────────────────────── Redis (Upstash) ─────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ──────────────────────────── Auth (Better Auth) ───────────────────────
BETTER_AUTH_SECRET="troque-por-32-bytes-aleatorios"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────── LLM (ADR-012) ─────────────────────────
# google | groq | openrouter | template
LLM_PROVIDER="template"
GOOGLE_AI_API_KEY=""   # https://aistudio.google.com/apikey  (grátis, sem cartão)
GROQ_API_KEY=""        # https://console.groq.com/keys       (grátis, sem cartão)

# ──────────────────────────────── Push (VAPID) ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@clashpilot.app"

# ──────────────────────────────────── App ──────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GATEWAY_PORT="4000"
